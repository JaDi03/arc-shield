# The RPC url for the Arc network. 
# Automatically set in your terminal when you login using arc-canteen login.
RPC="https://rpc.testnet.arc.network"

# The private key of the deploying / owner account.
PRIVATE_KEY="0x..."

# (Optional) The private key of the authorized AI Agent account.
AGENT_PRIVATE_KEY="0x..."

# (Optional) The address of the deployed ArcShield contract.
SHIELD_CONTRACT_ADDRESS="0x..."
